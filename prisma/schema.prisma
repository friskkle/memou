generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum date_idea_status {
  idea
  planned
  completed
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model journal_entries {
  id            Int      @id @default(autoincrement())
  journal_id    Int
  title         String?  @db.VarChar(64)
  content       String?
  created_date  DateTime @db.Date
  last_modified DateTime @db.Timestamp(6)
  creator       String
  journals      journals @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_ref")
  user          user     @relation(fields: [creator], references: [id], onDelete: NoAction, map: "user_id")
}

model date_ideas {
  id             Int              @id @default(autoincrement())
  journal_id     Int
  title          String           @db.VarChar(96)
  description    String?
  category       String           @db.VarChar(32)
  budget         String           @db.VarChar(32)
  added_by       String
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  status         date_idea_status @default(idea)
  planned_at     DateTime?        @db.Timestamptz(6)
  completed_at   DateTime?        @db.Timestamptz(6)
  completed_note String?
  journals       journals         @relation(fields: [journal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "date_ideas_journal_ref")
  user           user             @relation(fields: [added_by], references: [id], onDelete: NoAction, map: "date_ideas_user_id")

  @@index([journal_id, status])
}

model journals {
  id              Int               @id @default(autoincrement())
  uuid            String
  title           String?           @db.VarChar(64)
  shared_with     String[]
  date_ideas      date_ideas[]
  journal_entries journal_entries[]
  user            user              @relation(fields: [uuid], references: [id], onDelete: NoAction, map: "user_id")
}

model session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user {
  id              String            @id
  name            String
  email           String            @unique
  emailVerified   Boolean
  image           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @db.Timestamptz(6)
  account         account[]
  date_ideas      date_ideas[]
  journal_entries journal_entries[]
  journals        journals[]
  session         session[]
}

model users {
  uuid         Int     @id @default(autoincrement())
  username     String?
  display_name String?
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)
}
